# @title 카카오톡 분석기
import pandas as pd
import re
import numpy as np
from datetime import datetime
from google.colab import files
import io
import matplotlib.pyplot as plt
import matplotlib.font_manager as fm
import seaborn as sns
import os

# ---------------------------------------------------------
# 1. 환경 설정 (한글 폰트)
# ---------------------------------------------------------
def setup_korean_font():
    # 폰트 설치가 안 되어 있으면 설치
    if not os.path.exists('/usr/share/fonts/truetype/nanum/NanumBarunGothic.ttf'):
        print("한글 폰트 설치 중... (약 30초 소요)")
        !sudo apt-get -q -y install fonts-nanum
        !sudo fc-cache -fv
        !rm ~/.cache/matplotlib -rf
    
    path = '/usr/share/fonts/truetype/nanum/NanumBarunGothic.ttf'
    if os.path.exists(path):
        font_prop = fm.FontProperties(fname=path)
        plt.rc('font', family=font_prop.get_name())
        fm.fontManager.addfont(path)
        plt.rcParams['axes.unicode_minus'] = False
        print("한글 폰트 설정 완료. (글자가 깨지면 [런타임]->[세션 다시 시작] 해주세요)")
    else:
        print("폰트 설치 후 [런타임]->[세션 다시 시작]이 필요합니다.")

# ---------------------------------------------------------
# 2. 파일 로더 (인코딩 자동 감지)
# ---------------------------------------------------------
def load_text_file(content_bytes):
    """바이트 컨텐츠를 utf-8 혹은 cp949로 디코딩"""
    try:
        return content_bytes.decode("utf-8")
    except UnicodeDecodeError:
        try:
            return content_bytes.decode("cp949")
        except:
            return ""

# ---------------------------------------------------------
# 3. 회원 매칭 로직
# ---------------------------------------------------------
def normalize_name(name):
    """매칭 확률을 높이기 위해 이름 정규화 (공백제거 + 소문자변환)"""
    if not isinstance(name, str): return ""
    return name.replace(" ", "").lower()

def filter_members(df, member_list_text):
    """데이터프레임에서 리스트에 없는 회원을 제거"""
    
    # 리스트 파싱
    raw_members = [line.strip() for line in member_list_text.split('\n') if line.strip()]
    if not raw_members:
        print("회원 리스트 파일이 비어있습니다!")
        return df
        
    print(f"불러온 회원 명단: {len(raw_members)}명")
    
    # 정규화된 집합 생성
    valid_members_norm = set([normalize_name(m) for m in raw_members])
    
    # 매칭 판별 함수
    def is_valid_member(chat_name):
        norm_chat_name = normalize_name(chat_name)
        
        # 1. 정확한 매칭
        if norm_chat_name in valid_members_norm:
            return True
        
        # 2. 포함 관계 확인 (닉네임 변경 대응)
        for valid_m in valid_members_norm:
            # 오매칭 방지를 위해 2글자 이상일 때만 포함관계 인정
            if len(valid_m) > 1 and len(norm_chat_name) > 1: 
                if valid_m in norm_chat_name or norm_chat_name in valid_m:
                    return True
        return False

    # 필터링 적용
    print("\n[회원 필터링 수행 중...]")
    df['IsMember'] = df['Name'].apply(is_valid_member)
    
    # 제외된 인원 로깅
    excluded_count = len(df[~df['IsMember']]['Name'].unique())
    print(f"리스트에 없어 제외된 닉네임 수: {excluded_count}개")
    
    return df[df['IsMember']].copy()

# ---------------------------------------------------------
# 4. 파싱 및 시각화 (기존 로직 유지)
# ---------------------------------------------------------
def parse_custom_format(file_content):
    chat_data = []
    lines = file_content.split('\n')
    date_pattern = r'(\d{4}년 \d{1,2}월 \d{1,2}일) (오전|오후) (\d{1,2}:\d{2})'

    i = 0
    while i < len(lines):
        line = lines[i].strip()
        if not line:
            i += 1; continue

        date_match = re.search(date_pattern, line)
        if date_match:
            date_str = date_match.group(1)
            full_time_str = f"{date_match.group(2)} {date_match.group(3)}"
            rest = line[date_match.end():].strip()
            
            if rest.startswith(',') and ('들어왔' in rest or '나갔' in rest):
                name = "SYSTEM"
                message = rest
            else:
                if rest.startswith(','): rest = rest[1:].strip()
                parts = rest.split(':', 1)
                name = parts[0].strip() if len(parts) == 2 else "UNKNOWN"
                message = parts[1].strip() if len(parts) == 2 else rest

            i += 1
            while i < len(lines):
                next_line = lines[i].strip()
                if re.search(date_pattern, next_line): break
                if next_line: message += '\n' + next_line
                i += 1
            
            if name != "SYSTEM":
                chat_data.append({'date': date_str, 'time': full_time_str, 'name': name, 'message': message})
        else:
            i += 1
    return pd.DataFrame(chat_data)

def parse_datetime_custom(date_str, time_str):
    try:
        date_parts = re.findall(r'\d+', date_str)
        year, month, day = map(int, date_parts)
        is_pm = '오후' in time_str
        time_parts = re.findall(r'\d+', time_str)
        hour, minute = (map(int, time_parts[:2]) if len(time_parts)>=2 else (0,0))
        if is_pm and hour < 12: hour += 12
        elif not is_pm and hour == 12: hour = 0
        return datetime(year, month, day, hour, minute)
    except:
        return pd.NaT

def analyze_and_visualize(df, title_prefix, filename_prefix):
    if df.empty: return None
    
    df['len'] = df['Message'].astype(str).apply(len)
    stats = df.groupby('Name').agg({'Message':'count', 'len':['sum', 'mean']})
    stats.columns = ['Count', 'TotalChars', 'AvgChars']
    
    total = stats['Count'].sum()
    stats['Pct'] = (stats['Count'] / total * 100).round(2)
    stats = stats.sort_values('Count', ascending=False)
    
    # Top 30 for visualization
    top = stats.head(30)
    
    plt.figure(figsize=(20, 12))
    plt.suptitle(f'{title_prefix} 분석 (총 {len(stats)}명)', fontsize=20)
    
    plt.subplot(2,2,1)
    plt.pie(top['Count'], labels=top.index, autopct='%1.1f%%', startangle=90, colors=sns.color_palette('pastel'))
    plt.title('메시지 점유율 (Top 30)')
    
    plt.subplot(2,2,2)
    sns.barplot(x=top.index, y='Count', data=top, palette='viridis')
    plt.xticks(rotation=90); plt.title('메시지 수 (Top 30)'); plt.grid(axis='y', ls='--', alpha=0.3)
    
    plt.subplot(2,2,4)
    sns.barplot(x=top.index, y='AvgChars', data=top, palette='rocket')
    plt.xticks(rotation=90); plt.title('평균 메시지 길이')

    plt.tight_layout(rect=[0, 0.03, 1, 0.95])
    
    img_name = f'{filename_prefix}_viz.png'
    plt.savefig(img_name, dpi=100)
    stats.to_csv(f'{filename_prefix}_stats.csv', encoding='utf-8-sig')
    return img_name, f'{filename_prefix}_stats.csv'

# ---------------------------------------------------------
# 5. 메인 실행
# ---------------------------------------------------------
def main():
    try: setup_korean_font()
    except: pass
    
    # 1. 회원 명단 파일 업로드
    print("\n" + "="*60)
    print("[STEP 1] '회원 명단' 텍스트 파일(.txt)을 업로드하세요.")
    print("   (내용 예시: 이름이 한 줄에 하나씩 적혀 있어야 합니다)")
    print("="*60)
    
    members_upload = files.upload()
    if not members_upload:
        print("회원 파일이 업로드되지 않았습니다.")
        return

    member_content = ""
    for _, content in members_upload.items():
        member_content = load_text_file(content)
        break # 첫 번째 파일만 사용

    # 2. 채팅 파일 업로드
    print("\n" + "="*60)
    print("[STEP 2] '카카오톡 대화' 파일(.txt)을 업로드하세요.")
    print("="*60)
    
    chat_upload = files.upload()
    
    for filename, content in chat_upload.items():
        print(f"\n>> 분석 시작: {filename}")
        chat_text = load_text_file(content)
        
        # 파싱
        df = parse_custom_format(chat_text)
        if df.empty:
            print("파싱 실패. 카카오톡 내보내기 형식이 맞는지 확인하세요.")
            continue

        df['DateTime'] = df.apply(lambda r: parse_datetime_custom(r['date'], r['time']), axis=1)
        df = df.dropna(subset=['DateTime'])
        df = df.rename(columns={'name':'Name', 'message':'Message'})
        
        # 필터링
        df_filtered = filter_members(df, member_content)
        if df_filtered.empty:
            print("회원 명단과 일치하는 대화가 하나도 없습니다.")
            continue

        # 기간 입력
        print("\n" + "-"*40)
        print(f"데이터 기간: {df_filtered['DateTime'].min().date()} ~ {df_filtered['DateTime'].max().date()}")
        s_in = input("시작일(YYYY-MM-DD, 엔터=전체): ").strip()
        e_in = input("종료일(YYYY-MM-DD, 엔터=전체): ").strip()
        
        try:
            start = pd.to_datetime(s_in) if s_in else df_filtered['DateTime'].min()
            end = pd.to_datetime(e_in).replace(hour=23,minute=59) if e_in else df_filtered['DateTime'].max()
            
            target_df = df_filtered[(df_filtered['DateTime'] >= start) & (df_filtered['DateTime'] <= end)]
            
            if not target_df.empty:
                f_prefix = f"{os.path.splitext(filename)[0]}_Final"
                t_prefix = f"{start.date()}~{end.date()}"
                img, csv = analyze_and_visualize(target_df, t_prefix, f_prefix)
                files.download(img)
                files.download(csv)
                print("\n분석 완료 및 다운로드!")
            else:
                print("해당 기간 데이터 없음.")
        except Exception as e:
            print(f"오류 발생: {e}")

if __name__ == "__main__":
    main()
