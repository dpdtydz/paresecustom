# 2. 카카오톡 대화 내용 파싱 함수 (대괄호 형식에 맞춘 개선 버전)
def parse_custom_format(file_content):
    chat_data = []
    lines = file_content.split('\n')
    current_date = None
    date_pattern = r'\d{4}년 \d{1,2}월 \d{1,2}일'

    i = 0
    while i < len(lines):
        line = lines[i].strip()
        if not line:
            i += 1
            continue

        # 날짜 헤더 줄 감지 (예: --------------- 2025년 2월 13일 목요일 ---------------)
        if line.startswith('---') or re.search(date_pattern, line):
            date_match = re.search(date_pattern, line)
            if date_match:
                current_date = date_match.group(0)
            i += 1
            continue

        # 일반 메시지 감지 (예: [roy] [오후 2:25] 메시지 내용)
        if line.startswith('[') and '] [' in line:
            try:
                parts = line.split('] [', 1)
                name = parts[0][1:]  # 대괄호 안의 이름
                time_message = parts[1]

                if ']' in time_message:
                    time, message = time_message.split(']', 1)
                    time = time.strip()
                    message = message.strip()

                    # 멀티라인 메시지 처리
                    i += 1
                    while i < len(lines):
                        next_line = lines[i].strip()
                        # 다음 메시지 헤더나 날짜선이 나오면 종료
                        if next_line.startswith('[') and '] [' in next_line:
                            break
                        if next_line.startswith('---') or re.search(date_pattern, next_line):
                            break
                        if next_line:
                            message += '\n' + next_line
                        i += 1

                    if name.lower() != 'system':
                        chat_data.append({'date': current_date, 'time': time, 'name': name, 'message': message})
                    continue
            except Exception as e:
                pass

        i += 1

    return pd.DataFrame(chat_data)

def parse_datetime_custom(date_str, time_str):
    try:
        if not date_str:
            return pd.NaT
        date_parts = re.findall(r'\d+', date_str)
        year, month, day = map(int, date_parts)
        is_pm = '오후' in time_str
        time_parts = re.findall(r'\d+', time_str)
        if len(time_parts) >= 2:
            hour, minute = map(int, time_parts[:2])
            if is_pm and hour < 12: hour += 12
            elif not is_pm and hour == 12: hour = 0
        else:
            hour, minute = 0, 0
        return datetime(year, month, day, hour, minute)
    except:
        return pd.NaT

# 3. 분석 및 시각화 로직
def analyze_and_visualize(df, title_prefix, filename_prefix):
    if df.empty: return None

    df['message_length'] = df['Message'].astype(str).apply(len)
    stats = df.groupby('Name').agg({
        'Message': 'count',
        'message_length': ['sum', 'mean']
    })
    stats.columns = ['MessageCount', 'TotalChars', 'AvgChars']
    total_msgs = stats['MessageCount'].sum()
    stats['MessagePercentage'] = (stats['MessageCount'] / total_msgs * 100).round(2)
    stats['AvgChars'] = stats['AvgChars'].round(1)
    stats = stats.sort_values('MessageCount', ascending=False)

    TOP_N = min(30, len(stats))
    top_stats = stats.head(TOP_N)

    fig = plt.figure(figsize=(20, 12))
    plt.suptitle(f'{title_prefix} 대화 지분율 분석 (상위 {TOP_N}명)', fontsize=22)
    colors = sns.color_palette('pastel', TOP_N)

    # 1. 메시지 수 Pie
    plt.subplot(2, 2, 1)
    plt.pie(top_stats['MessageCount'], labels=top_stats.index, autopct='%1.1f%%', startangle=90, colors=colors)
    plt.title('메시지 수 점유율')

    # 2. 메시지 수 Bar
    plt.subplot(2, 2, 2)
    sns.barplot(x=top_stats.index, y='MessageCount', data=top_stats, hue=top_stats.index, legend=False, palette='viridis')
    plt.title('회원별 메시지 전송 수')
    plt.xticks(rotation=90)

    # 3. 평균 메시지 글자 길이 Bar
    plt.subplot(2, 2, 3)
    sns.barplot(x=top_stats.index, y='AvgChars', data=top_stats, hue=top_stats.index, legend=False, palette='rocket')
    plt.title('메시지 평균 글자 수')
    plt.xticks(rotation=90)

    plt.tight_layout(rect=[0, 0.03, 1, 0.95])

    img_filename = f'{filename_prefix}_viz.png'
    plt.savefig(img_filename, dpi=150)
    plt.show()

    csv_filename = f'{filename_prefix}_stats.csv'
    stats.to_csv(csv_filename, encoding='utf-8-sig')

    return stats, img_filename, csv_filename

# 4. 메인 실행 트리거
print("\n👉 분석할 카카오톡 대화 내용(.txt) 파일을 업로드하세요.")
uploaded = files.upload()

for filename, content in uploaded.items():
    print(f'\n>> 파일 "{filename}" 분석 진행 중...')
    try:
        file_content = io.StringIO(content.decode("utf-8")).read()
    except:
        file_content = io.StringIO(content.decode("cp949")).read()

    raw_df = parse_custom_format(file_content)
    if raw_df.empty:
        print("❌ 오류: 데이터 파싱에 실패했습니다. 파일 포맷을 확인해 주세요.")
        continue

    # 기본 시스템 메시지 송신자 제거 및 정적 필터링
    system_keywords = ['system', 'unknown', '방장봇', '봇', 'bot']
    df = raw_df[~raw_df['name'].str.lower().isin(system_keywords)].copy()

    # 날짜 가공
    df['DateTime'] = df.apply(lambda row: parse_datetime_custom(row['date'], row['time']), axis=1)
    df = df.dropna(subset=['DateTime'])
    df = df[['DateTime', 'name', 'message']].rename(columns={'name': 'Name', 'message': 'Message'})

    # 파일 안에서 자동으로 고유 유저 리스트 감지
    detected_members = df['Name'].unique().tolist()
    print(f"\n✅ 대화방 파일에서 총 {len(detected_members)}명의 고유 활동 유저를 자동 감지했습니다.")

    min_date = df['DateTime'].min()
    max_date = df['DateTime'].max()
    print(f"💬 추출 가능 데이터 기간: {min_date.strftime('%Y-%m-%d')} ~ {max_date.strftime('%Y-%m-%d')}")

    start_input = input("분석 시작일 입력 (형식 YYYY-MM-DD, 미입력 시 전체): ").strip()
    end_input = input("분석 종료일 입력 (형식 YYYY-MM-DD, 미입력 시 전체): ").strip()

    try:
        start_date = pd.to_datetime(start_input) if start_input else min_date
        end_date = pd.to_datetime(end_input).replace(hour=23, minute=59, second=59) if end_input else max_date

        final_mask = (df['DateTime'] >= start_date) & (df['DateTime'] <= end_date)
        final_analysis_df = df[final_mask].copy()

        if final_analysis_df.empty:
            print("⚠️ 설정한 기간 내에 데이터가 존재하지 않습니다.")
            continue

        file_prefix = f"{os.path.splitext(filename)[0]}_dynamic_stats"
        title_prefix = f"{start_date.strftime('%Y-%m-%d')} ~ {end_date.strftime('%Y-%m-%d')}"

        # 분석 및 리포트 작성
        stats, img_file, csv_file = analyze_and_visualize(final_analysis_df, title_prefix, file_prefix)

        if stats is not None:
            print("\n📊 자동 검출 기반 요약 리포트 (상위 10명):")
            display(stats.head(10))

            # 파일 다운로드
            files.download(img_file)
            files.download(csv_file)
            print(f"\n🎉 분석 파일 저장 완료: '{img_file}', '{csv_file}' 다운로드가 시작됩니다.")
    except Exception as e:
        print(f"❌ 처리 중 예외 발생: {str(e)}")
